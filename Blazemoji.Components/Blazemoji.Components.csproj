<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The editor as components: everything a host shows, the state behind it, and the
       interfaces a host implements. It references no host and nothing that only one kind of
       host has, so that a web app and a desktop app can both use it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blazemoji</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazemoji.Core\Blazemoji.Core.csproj" />
    <ProjectReference Include="..\Blazemoji.Toolchain\Blazemoji.Toolchain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blazemoji.Test" />
  </ItemGroup>

</Project>
