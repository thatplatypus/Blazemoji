@using System.Globalization
@using Blazemoji.Interop
@using MudBlazor.State
@using MudBlazor.Utilities
@inherits MudComponentBase
@implements IAsyncDisposable
@inject SplitViewInterop Interop

@* Two parts with a divider between them that can be dragged, around MudBlazor's split panel.
   The panel works in pixels, says nothing when its divider is let go and cannot hide a part.
   This adds those: the divider's place is a share of the room, so it holds as the window
   changes size; the caller is told where it was let go; and the first part can be hidden
   without being taken off the page. SplitView.razor.css says how a share places the divider,
   and Scripts/splitView.ts is what settles a drag on one. *@
<div class="@RootClass" style="@RootStyle" @attributes="UserAttributes" @ref="_root">
    <MudSplitPanel Horizontal="@Stacked"
                   Transparent="true"
                   MinPanelSize="@MinPanelSize"
                   ResetOnDoubleClick="false"
                   Class="split-view-panels"
                   ClassFirstPanel="split-view-first"
                   ClassSecondPanel="split-view-second"
                   ClassDivider="split-view-divider">
        <FirstPanel><SplitViewPart @ref="_firstPart" Of="_first" /></FirstPanel>
        <SecondPanel><SplitViewPart @ref="_secondPart" Of="_second" /></SecondPanel>
    </MudSplitPanel>
</div>

@code {
    private readonly ParameterState<double> _share;
    private readonly Func<RenderFragment?> _first;
    private readonly Func<RenderFragment?> _second;

    private ElementReference _root;
    private SplitViewPart? _firstPart;
    private SplitViewPart? _secondPart;
    private DotNetObjectReference<SplitView>? _self;

    // What its own element showed when it was last drawn, and whether it shows something else now.
    private (bool Stacked, bool FirstHidden, int MinPanelSize, string? Class, string? Style, double Share, double DefaultShare, string? DividerLabel)? _drawn;
    private bool _drawAgain = true;

    // What the script was last given, which is what it has to be given again to change.
    private (double DefaultShare, string? DividerLabel)? _attached;

    // The share the script last reported, which a caller that keeps the share hands back, and
    // the Share parameter as it last was. A Share that is neither is the caller's own.
    private double? _reported;
    private double _given;
    private bool _release;

    public SplitView()
    {
        using var registerScope = CreateRegisterScope();
        _share = registerScope.RegisterParameter<double>(nameof(Share))
            .WithParameter(() => Share)
            .WithEventCallback(() => ShareChanged);
        _first = () => First;
        _second = () => Second;
    }

    /// <summary>The part on the left, or on top when <see cref="Stacked"/>.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? First { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? Second { get; set; }

    /// <summary>One part above the other. Otherwise they are side by side.</summary>
    [Parameter]
    public bool Stacked { get; set; }

    /// <summary>The first part's share of the room, from 0 to 1.</summary>
    [Parameter]
    public double Share { get; set; } = 0.5;

    /// <summary>
    /// Raised when the divider has been let go somewhere new. The page already shows it
    /// there. A caller that hands back another share, such as one it keeps within limits,
    /// moves the divider to that.
    /// </summary>
    [Parameter]
    public EventCallback<double> ShareChanged { get; set; }

    /// <summary>Where a double-click on the divider puts it.</summary>
    [Parameter]
    public double DefaultShare { get; set; } = 0.5;

    /// <summary>
    /// Gives the second part the whole room. The first stays on the page, with whatever it
    /// was showing, and comes back at its share.
    /// </summary>
    [Parameter]
    public bool FirstHidden { get; set; }

    /// <summary>The fewest pixels either part is left, by a drag or by a small window.</summary>
    [Parameter]
    public int MinPanelSize { get; set; } = 120;

    /// <summary>What the divider is called for someone who cannot see it. Without one it has MudBlazor's words for any divider.</summary>
    [Parameter]
    public string? DividerLabel { get; set; }

    private string RootClass => new CssBuilder("split-view")
        .AddClass("stacked", Stacked)
        .AddClass("first-hidden", FirstHidden)
        .AddClass(Class)
        .Build();

    private string RootStyle => new StyleBuilder()
        .AddStyle("--split-share", _share.Value.ToString("0.######", CultureInfo.InvariantCulture))
        .AddStyle("--split-min", MinPanelSize.ToString(CultureInfo.InvariantCulture) + "px")
        .AddStyle(Style)
        .Build();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _given = Share;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (Share != _given)
        {
            _given = Share;
            _release = _reported is not { } reported || Math.Abs(Share - reported) > 0.000001;
        }

        // The caller's content changes far more often than anything on this component's own
        // element. Drawing this again draws the panel again, and the panel asks the page a
        // question every time it is drawn, so that is kept for when its own element changes.
        // The parts are drawn again either way.
        var now = (Stacked, FirstHidden, MinPanelSize, Class, Style, _share.Value, DefaultShare, DividerLabel);
        _drawAgain = _drawn != now;
        _drawn = now;
        _firstPart?.Refresh();
        _secondPart?.Refresh();
    }

    protected override bool ShouldRender() => _drawAgain;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _self = DotNetObjectReference.Create(this);

        if (_self is not null && _attached != (DefaultShare, DividerLabel))
        {
            _attached = (DefaultShare, DividerLabel);
            await Interop.AttachAsync(_root, _self, DefaultShare, DividerLabel);
        }

        if (_release)
        {
            _release = false;
            await Interop.ReleaseAsync(_root);
        }
    }

    /// <summary>Called by the script when the divider has been let go somewhere new, which the page already shows.</summary>
    /// <param name="share">The first part's share of the room, as the style sheet counts it.</param>
    [JSInvokable]
    public async Task DividerMovedAsync(double share)
    {
        // A part with no size, such as one inside something hidden, has no share to report.
        if (!double.IsFinite(share))
            return;

        await TakeAsync(Math.Clamp(share, 0, 1));
    }

    /// <summary>Called by the script when the divider has been double-clicked, and put back at <see cref="DefaultShare"/>.</summary>
    [JSInvokable]
    public Task DividerResetAsync() => TakeAsync(DefaultShare);

    private Task TakeAsync(double share) => InvokeAsync(async () =>
    {
        _reported = share;
        await _share.SetValueAsync(share);

        // Its own element carries the share for the style sheet, whether or not a caller keeps it.
        _drawAgain = true;
        _drawn = null;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_self is null)
            return;

        try
        {
            await Interop.DetachAsync(_root);
        }
        catch (JSDisconnectedException)
        {
            // The page has gone, and the divider with it.
        }

        _self.Dispose();
        _self = null;
    }
}
