<Project Sdk="Microsoft.NET.Sdk">

  <!-- What Blazemoji knows about Emojicode and about projects, with no UI in it: the keyword
       catalog, the code intelligence, the project model and its templates. It must never
       reference Blazor, MudBlazor, the components or a host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blazemoji</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GEmojiSharp" Version="4.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazemoji.Toolchain\Blazemoji.Toolchain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blazemoji.Test" />
  </ItemGroup>

</Project>
