<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazemoji.Toolchain\Blazemoji.Toolchain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Emojicode 1.0 beta 2 compiler for x86_64 Linux and its stock packages. They travel
         to the output of whatever hosts the local toolchain. -->
    <None Update="emojicodec\**;packages\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blazemoji.Test" />
  </ItemGroup>

</Project>
