@using Blazemoji.Layout;
@using MudBlazor
@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="0" Class="border-b border-solid mud-border-lines-default">
        <MudText Typo="Typo.h4">🔥 Blazemoji</MudText>
        <MudSpacer />
        @if(_isDarkMode)
        {
            <MudTooltip Text="Light Mode">
                <MudIconButton Icon="@BlazemojiIcons.LightMode" Color="Color.Inherit" OnClick="ToggleDarkMode" />
            </MudTooltip>
        }
        else
        {
            <MudTooltip Text="Dark Mode">
                <MudIconButton Icon="@BlazemojiIcons.DarkMode" Color="Color.Inherit" OnClick="ToggleDarkMode" />
            </MudTooltip>
        }
        <!--
        <MudTooltip Text="Settings">
            <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" />
        </MudTooltip>
        -->
        <MudTooltip Text="Emojicode Documentation">
            <MudIconButton Href="https://www.emojicode.org/docs/reference/" Target="_blank" Icon="@BlazemojiIcons.Documentation" Color="Color.Inherit" />
        </MudTooltip>

        <MudTooltip Text="GitHub">
            <MudIconButton Href="https://github.com/thatplatypus/Blazemoji" Target="_blank" Icon="@BlazemojiIcons.GitHub" Color="Color.Inherit" />
        </MudTooltip>
    </MudAppBar>
    <MudMainContent>
        <CascadingValue Name="DarkMode" Value="@_isDarkMode">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

@code {
    private MudTheme _theme = new Theme();
    private bool _isDarkMode = false;
    private string _themeIcon = Icons.Material.Outlined.LightMode;
    private MudThemeProvider _mudThemeProvider = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var darkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            if (darkMode)
            {
                ToggleDarkMode();
            }

            StateHasChanged();
        }
    }

    // The editor is inside the cascading value above and takes its colours from the page.
    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }
}