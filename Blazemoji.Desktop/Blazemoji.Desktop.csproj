<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The desktop host: the editor in a window of its own, with projects kept as folders on
       disk. It holds what only a desktop app has (the window, opening links in the system's
       browser, the smoke run) and no logic of the editor's. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blazemoji.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.2.0 is the last release of Hermes built for .NET 10. Later ones are .NET 11 only. -->
    <PackageReference Include="Mythetech.Hermes.Blazor" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazemoji.Components\Blazemoji.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
