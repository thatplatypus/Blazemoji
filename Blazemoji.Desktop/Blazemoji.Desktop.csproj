<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The desktop host: the editor in a window of its own, with projects kept as folders on
       disk. It holds what only a desktop app has (the window, opening links in the system's
       browser, the smoke run) and no logic of the editor's. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blazemoji.Desktop</RootNamespace>
    <!-- The program is called what the app is called, which is what packaging and signing
         look for: Blazemoji.app holds an executable named Blazemoji. -->
    <AssemblyName>Blazemoji</AssemblyName>
    <!-- The icon Windows shows for the program's file. scripts/build-icons.sh makes it. -->
    <ApplicationIcon>wwwroot\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.2.0 is the last release of Hermes built for .NET 10. Later ones are .NET 11 only. -->
    <PackageReference Include="Mythetech.Hermes.Blazor" Version="1.2.0" />
    <!-- What an installed copy needs so that its installer and updater can talk to it. -->
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazemoji.Components\Blazemoji.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
