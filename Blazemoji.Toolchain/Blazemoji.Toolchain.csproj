<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blazemoji.Test" />
  </ItemGroup>

  <ItemGroup>
    <!-- pmj, when scripts/get-pmj.sh has fetched one. It travels to the output of whatever
         references this library, which is where each app looks for it, and into a publish.
         The images are given theirs by the Dockerfile. -->
    <None Update="pmj\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
